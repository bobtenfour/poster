@page "/technician/configuration"
@layout TechnicianLayout
@attribute [Authorize(Policy = PosterAccess.OperatorPolicy)]
@inject NavigationManager Navigation

<PageTitle>Configuration</PageTitle>

@* Operator Configuration Presentation Contract v1, section 4: a static landing with three equal cards. *@
<section class="epx-blueignix-home" aria-label="Configuration">
    <PageHeader Kicker="Configuration" Title="Operator configuration" Subtitle="Active values are available for new work. Inactive values stay on record until you ask to see them." />

    <nav class="epx-config-cards" aria-label="Configuration windows">
        <a id="config-card-departments" class="epx-config-card" href="@ApplicationUris.BrowserPath(Navigation, "/technician/configuration/departments")">
            <span class="epx-config-card-title">Departments</span>
            <span class="epx-config-card-detail">Departments and Reasons / Events</span>
        </a>
        <a id="config-card-printers" class="epx-config-card" href="@ApplicationUris.BrowserPath(Navigation, "/technician/configuration/printers")">
            <span class="epx-config-card-title">Printers</span>
            <span class="epx-config-card-detail">Printer models and compatibility</span>
        </a>
        <a id="config-card-consumables" class="epx-config-card" href="@ApplicationUris.BrowserPath(Navigation, "/technician/configuration/consumables")">
            <span class="epx-config-card-title">Consumables &amp; Materials</span>
            <span class="epx-config-card-detail">Consumable types and catalog</span>
        </a>
    </nav>
</section>
