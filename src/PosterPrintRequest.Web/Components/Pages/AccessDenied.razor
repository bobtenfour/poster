@page "/Account/AccessDenied"
@layout EntryLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation

<PageTitle>Access denied</PageTitle>

<section class="epx-entry" aria-label="Access denied">
    <div class="epx-entry-panel">
        <p class="epx-blueignix-kicker">UIC Dentistry School</p>
        <h1>Access denied</h1>
        <p class="epx-blueignix-subtitle">Your account cannot open this area.</p>
        @if (IsTechnician && IsRequester)
        {
            <a class="epx-button epx-button-primary" href="@ApplicationUris.BrowserPath(Navigation, InstitutionalEntry.OperatorHome)">Return to the technician workspace</a>
            <a class="epx-button" href="@ApplicationUris.BrowserPath(Navigation, InstitutionalEntry.StaffHome)">Return home</a>
        }
        else if (IsTechnician)
        {
            <a class="epx-button epx-button-primary" href="@ApplicationUris.BrowserPath(Navigation, InstitutionalEntry.OperatorHome)">Return to the technician workspace</a>
        }
        else if (IsRequester)
        {
            <a class="epx-button epx-button-primary" href="@ApplicationUris.BrowserPath(Navigation, InstitutionalEntry.StaffHome)">Return home</a>
        }
        else
        {
            <p>Your Windows account is not in an authorized group.</p>
        }
    </div>
    <div class="epx-entry-visual">
        <img src="@ApplicationUris.BrowserPath(Navigation, "/img/entry/plotter-technician.jpg")" alt="A technician printing a poster on a large-format plotter." />
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool IsRequester { get; set; }

    private bool IsTechnician { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        var state = await AuthenticationState;
        IsRequester = (await Authorization.AuthorizeAsync(state.User, PosterAccess.UserPolicy)).Succeeded;
        IsTechnician = (await Authorization.AuthorizeAsync(state.User, PosterAccess.OperatorPolicy)).Succeeded;
    }
}
