@page "/technician"
@layout TechnicianLayout
@attribute [Authorize(Policy = PosterAccess.OperatorPolicy)]
@using System.Globalization

<PageTitle>Operations</PageTitle>

<section class="epx-blueignix-home" aria-label="Operations">
    <PageHeader Kicker="Operations" Title="Dashboard" Subtitle="@Snapshot.PeriodLabel" />

    @if (SearchState == "invalid")
    {
        <Callout Kicker="Poster ID" Title="Enter a Poster ID such as POSTER-2026-000001." Tone="warning">
            Search again with the public Poster ID.
        </Callout>
    }
    else if (SearchState == "missing")
    {
        <Callout Kicker="Poster ID" Title="No request uses that Poster ID." Tone="warning">
            @SearchId
        </Callout>
    }
    else if (SearchView is not null)
    {
        <Callout Kicker="Poster ID" Title="@SearchView.PosterId" Tone="success">
            <p>@SearchView.RequesterName · @(SearchView.EventName ?? "No event")</p>
            <p><a href="@($"/technician/work/{SearchView.PosterId}")">Open poster</a></p>
        </Callout>
    }

    <section class="epx-blueignix-panel epx-supply" aria-labelledby="printing-supplies-title">
        <header class="epx-supply-header">
            <div class="epx-supply-heading">
                <span class="epx-supply-mark epx-supply-mark-printer" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M7 8V3.8h10V8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M6 13.5V9.2h12v4.3" fill="currentColor" opacity=".22"/><rect x="4.5" y="8" width="15" height="7.2" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M8 13.2h8V20H8z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M16.2 10.4h1.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </span>
                <div>
                    <h2 id="printing-supplies-title">Printing Supplies</h2>
                    <p>Monitor toner, paper, and lamination stock.</p>
                </div>
            </div>
            <a class="epx-button epx-button-secondary" href="/technician/inventory">View Inventory <span class="epx-supply-chevron" aria-hidden="true">›</span></a>
        </header>
        <div class="epx-supply-cards">
            <article class="epx-supply-summary epx-supply-summary-reorder">
                <header class="epx-supply-summary-header">
                    <span class="epx-supply-mark epx-supply-mark-reorder" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M4.2 5.2h1.7l.6 2.2h12.1l-1.5 6.1H8.1L6.6 6.4H4.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.2" cy="17.6" r="1.35" fill="currentColor"/><circle cx="16.2" cy="17.6" r="1.35" fill="currentColor"/></svg>
                    </span>
                    <div>
                        <h3>Needs Reorder</h3>
                        <p class="epx-supply-summary-note">Items at or below reorder threshold.</p>
                    </div>
                    <p class="epx-supply-total" id="supply-reorder-total">
                        <span class="epx-supply-total-value">@Attention.NeedsReorder.Total.ToString(CultureInfo.InvariantCulture)</span>
                        <span class="epx-supply-total-unit">Items</span>
                    </p>
                </header>
                <SupplyCategoryTiles Prefix="supply-reorder" Cartridges="@Attention.NeedsReorder.Cartridges" Paper="@Attention.NeedsReorder.Paper" LaminatingMaterials="@Attention.NeedsReorder.LaminatingMaterials" />
            </article>
            <article class="epx-supply-summary epx-supply-summary-expiring">
                <header class="epx-supply-summary-header">
                    <span class="epx-supply-mark epx-supply-mark-expiring" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="7.2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 7.6V12l2.8 1.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <div>
                        <h3>Expiring Soon</h3>
                        <p class="epx-supply-summary-note">Items approaching expiration date.</p>
                    </div>
                    <p class="epx-supply-total" id="supply-expiring-total">
                        <span class="epx-supply-total-value">@Attention.ExpiringSoonSummary.Total.ToString(CultureInfo.InvariantCulture)</span>
                        <span class="epx-supply-total-unit">Items</span>
                    </p>
                </header>
                <SupplyCategoryTiles Prefix="supply-expiring" Cartridges="@Attention.ExpiringSoonSummary.Cartridges" Paper="@Attention.ExpiringSoonSummary.Paper" LaminatingMaterials="@Attention.ExpiringSoonSummary.LaminatingMaterials" />
            </article>
        </div>
    </section>

    <section class="epx-stat-grid" aria-label="Operational totals">
        <article class="epx-stat-card">
            <h2 class="epx-stat-label">Posters pending printing</h2>
            <p class="epx-stat-value" id="stat-pending">@Snapshot.PendingPrinting</p>
            <p class="epx-stat-detail">Not marked printed</p>
        </article>
        <article class="epx-stat-card">
            <h2 class="epx-stat-label">Posters printed this month</h2>
            <p class="epx-stat-value" id="stat-month">@Snapshot.PrintedThisMonth</p>
            <p class="epx-stat-detail">@Snapshot.PeriodLabel</p>
        </article>
        <article class="epx-stat-card">
            <h2 class="epx-stat-label">Posters printed this year</h2>
            <p class="epx-stat-value" id="stat-year">@Snapshot.PrintedThisYear</p>
            <p class="epx-stat-detail">@Snapshot.Year.ToString(CultureInfo.InvariantCulture)</p>
        </article>
        <article class="epx-stat-card">
            <h2 class="epx-stat-label">Posters awaiting pickup</h2>
            <p class="epx-stat-value" id="stat-pickup">@Snapshot.AwaitingPickup</p>
            <p class="epx-stat-detail">Notified, still in the shop</p>
        </article>
        <article class="epx-stat-card">
            <h2 class="epx-stat-label">Total posters processed</h2>
            <p class="epx-stat-value" id="stat-processed">@Snapshot.TotalProcessed</p>
            <p class="epx-stat-detail">Pickup recorded</p>
        </article>
    </section>
    <p class="epx-helper-text">Pending printing, awaiting pickup, and total processed are current. Printed counts and technician ranking use @Snapshot.PeriodLabel and the date received.</p>

    <Panel Kicker="Action" Title="Needs action">
        @if (Snapshot.Queue.Count == 0)
        {
            <p>No posters are waiting.</p>
        }
        else
        {
            <div class="epx-table-wrap">
                <table class="epx-table" id="work-queue">
                    <caption class="epx-sr-only">Posters that still need a stage completed</caption>
                    <thead>
                        <tr>
                            <th scope="col">Poster ID</th>
                            <th scope="col">Requester</th>
                            <th scope="col">Event</th>
                            <th scope="col">Stage</th>
                            <th scope="col">Date in</th>
                            <th scope="col">Lamination</th>
                            <th scope="col"><span class="epx-sr-only">Open</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Snapshot.Queue)
                        {
                            <tr>
                                <td>@item.PosterId</td>
                                <td>@item.RequesterName</td>
                                <td>@(item.EventName ?? "No event")</td>
                                <td><span class="epx-stage epx-stage-@item.Stage.ToLowerInvariant()">@item.Stage</span></td>
                                <td>@item.DateIn.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                                <td>@(item.LaminationRequested ? "Requested" : "No")</td>
                                <td><a class="epx-button epx-button-secondary" href="@($"/technician/work/{item.PosterId}")">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Panel>

    <Panel Kicker="@Snapshot.PeriodLabel" Title="Technician performance">
        <form class="epx-tech-period" method="get" action="/technician">
            <label class="epx-label" for="workspace-period">Month</label>
            <input id="workspace-period" class="epx-input" name="period" type="month" value="@PeriodValue" />
            @if (!string.IsNullOrWhiteSpace(SearchId))
            {
                <input type="hidden" name="posterId" value="@SearchId" />
            }
            <button class="epx-button epx-button-secondary" type="submit">Apply</button>
        </form>
        @if (Snapshot.Performance.Count == 0)
        {
            <p>No posters were printed in this period.</p>
        }
        else
        {
            <div class="epx-table-wrap">
                <table class="epx-table" id="technician-performance">
                    <caption class="epx-sr-only">Technicians ranked by posters printed in @Snapshot.PeriodLabel</caption>
                    <thead>
                        <tr>
                            <th scope="col">Rank</th>
                            <th scope="col">Technician</th>
                            <th scope="col">Posters printed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var person in Snapshot.Performance)
                        {
                            <tr>
                                <td>@person.Rank.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@person.Technician</td>
                                <td>@person.PostersPrinted.ToString(CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Panel>
</section>
