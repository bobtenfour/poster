@page "/technician/library"
@page "/technician/library/{*RelativePath}"
@layout TechnicianLayout
@attribute [Authorize(Policy = PosterAccess.OperatorPolicy)]
@rendermode InteractiveServer
@using PosterPrintRequest.Web.Requests

<PageTitle>Poster library</PageTitle>
<SessionGuard />

<section class="epx-blueignix-home" aria-label="Poster library">
    <PageHeader Kicker="Library"
                Title="Poster library"
                Subtitle="Events and requests without an event each have a blue TO BE PRINTED folder and a green PRINTED folder." />

    @if (Listing is null)
    {
        <Callout Kicker="Library" Title="That location is not in the poster library." Tone="warning">
            Choose a folder from the library.
        </Callout>
    }
    else if (!Listing.Available)
    {
        <Callout Kicker="Library" Title="The poster library is not available." Tone="warning">
            Storage has to be ready before folders can be opened.
        </Callout>
    }
    else
    {
        <div class="epx-library-nav">
            @if (Listing.Segments.Count > 0)
            {
                <a class="epx-button" href="@ApplicationUris.BrowserPath(Navigation, ParentHref(Listing.Segments))">Up</a>
            }
            <nav aria-label="Library folders">
                <ol class="epx-crumb">
                    <li>
                        @if (Listing.Segments.Count == 0)
                        {
                            <span aria-current="page">Library</span>
                        }
                        else
                        {
                            <a href="@ApplicationUris.BrowserPath(Navigation, "/technician/library")">Library</a>
                        }
                    </li>
                    @for (var index = 0; index < Listing.Segments.Count; index++)
                    {
                        var segment = Listing.Segments[index];
                        var last = index == Listing.Segments.Count - 1;
                        <li>
                            @if (last)
                            {
                                <span aria-current="page">@segment</span>
                            }
                            else
                            {
                                <a href="@ApplicationUris.BrowserPath(Navigation, CrumbHref(Listing.Segments.Take(index + 1)))">@segment</a>
                            }
                        </li>
                    }
                </ol>
            </nav>
        </div>

        @if (!string.IsNullOrWhiteSpace(Notice))
        {
            <p class="epx-field-error" role="alert">@Notice</p>
        }

        @if (Listing.Entries.Count == 0)
        {
            <p>This folder is empty.</p>
        }
        else
        {
            <ul class="epx-folder-grid" id="poster-library">
                @foreach (var entry in Listing.Entries)
                {
                    <li>
                        <article class="@FolderClass(entry)">
                            <p class="epx-blueignix-kicker">@entry.Kind</p>
                            @if (entry.NavigateHref is not null)
                            {
                                <a class="epx-folder-name" href="@ApplicationUris.BrowserPath(Navigation, entry.NavigateHref)">@entry.Name</a>
                            }
                            else
                            {
                                <p class="epx-folder-name">@entry.Name</p>
                            }
                            @if (entry.WorkHref is not null || entry.ViewHref is not null || entry.CanDelete || entry.CanRestore)
                            {
                                <p class="epx-folder-actions">
                                    @if (entry.WorkHref is not null)
                                    {
                                        <a href="@ApplicationUris.BrowserPath(Navigation, entry.WorkHref)">Open poster</a>
                                    }
                                    @if (entry.ViewHref is not null)
                                    {
                                        <a href="@ApplicationUris.BrowserPath(Navigation, entry.ViewHref)" target="_blank" rel="noopener">View</a>
                                    }
                                    @if (entry.CanDelete || entry.CanRestore)
                                    {
                                        <PosterRetentionActions PosterName="@entry.Name"
                                                                CanDelete="@entry.CanDelete"
                                                                CanRestore="@entry.CanRestore"
                                                                ConfirmDelete="() => DeletePosterAsync(entry)"
                                                                Restore="() => RestorePosterAsync(entry)" />
                                    }
                                </p>
                            }
                        </article>
                    </li>
                }
            </ul>
        }
    }
</section>

@code {
    [Parameter]
    public string? RelativePath { get; set; }

    [Inject]
    private ITechnicianLibrary Library { get; set; } = null!;

    [Inject]
    private IPosterRetention Retention { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthenticationState { get; set; } = null!;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private LibraryListing? Listing { get; set; }

    private string? Notice { get; set; }

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        IReadOnlyList<RetainedPosterListing> retained;
        try
        {
            retained = await Retention.ListRetainedAsync(CancellationToken.None);
        }
        catch (Exception)
        {
            retained = [];
            Notice = PosterRetentionMessages.ListFailed;
        }

        Listing = Library.List(RelativePath, retained);
    }

    private async Task DeletePosterAsync(LibraryEntry entry)
    {
        if (string.IsNullOrWhiteSpace(entry.PosterId))
        {
            return;
        }

        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        var outcome = await Retention.ConfirmDeletionAsync(entry.PosterId, user, CancellationToken.None);
        Notice = outcome.Completed ? null : outcome.Message;
        await ReloadAsync();
    }

    private async Task RestorePosterAsync(LibraryEntry entry)
    {
        if (string.IsNullOrWhiteSpace(entry.PosterId))
        {
            return;
        }

        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        var outcome = await Retention.RestoreAsync(entry.PosterId, user, CancellationToken.None);
        Notice = outcome.Completed ? null : outcome.Message;
        await ReloadAsync();
    }

    private static string CrumbHref(IEnumerable<string> segments) =>
        PosterPrintRequest.Web.Requests.TechnicianLibrary.LibraryHref(segments);

    private static string ParentHref(IReadOnlyList<string> segments) =>
        segments.Count <= 1
            ? "/technician/library"
            : PosterPrintRequest.Web.Requests.TechnicianLibrary.LibraryHref(segments.Take(segments.Count - 1));

    private static string FolderClass(LibraryEntry entry) => entry.Tone switch
    {
        PrintFolderPaths.ToBePrintedTone => "epx-folder-card epx-folder-to-be-printed",
        PrintFolderPaths.PrintedTone => "epx-folder-card epx-folder-printed",
        _ => "epx-folder-card"
    };
}
