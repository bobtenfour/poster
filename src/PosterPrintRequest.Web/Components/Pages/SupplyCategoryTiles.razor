@using System.Globalization
@using PosterPrintRequest.Web.Requests
@inject NavigationManager Navigation

@* Consumables Inventory Contract section 4.8: one tile per active consumable type, in the order set in Configuration. *@
<div class="epx-supply-categories">
    @foreach (var type in Counts)
    {
        <a id="@($"{Prefix}-type-{type.ConsumableTypeId.ToString(CultureInfo.InvariantCulture)}")" class="epx-supply-tile" href="@ApplicationUris.BrowserPath(Navigation, "/technician/inventory#" + TechnicianInventory.PanelId(type.ConsumableTypeId))">
            <span class="epx-supply-tile-icon" aria-hidden="true">
                @switch (IconFor(type.Name))
                {
                    case TileIcon.Cartridges:
                        <svg viewBox="0 0 68 48" focusable="false">
                            <rect x="2" y="12" width="14" height="30" rx="2.4" fill="#1496c9"/>
                            <rect x="2" y="6" width="14" height="9" rx="1.8" fill="#f2f5f8"/>
                            <rect x="5" y="20" width="8" height="11" rx="1.2" fill="#0c6f96"/>
                            <rect x="18.5" y="12" width="14" height="30" rx="2.4" fill="#d23a86"/>
                            <rect x="18.5" y="6" width="14" height="9" rx="1.8" fill="#f2f5f8"/>
                            <rect x="21.5" y="20" width="8" height="11" rx="1.2" fill="#9d215f"/>
                            <rect x="35" y="12" width="14" height="30" rx="2.4" fill="#f0c04a"/>
                            <rect x="35" y="6" width="14" height="9" rx="1.8" fill="#f2f5f8"/>
                            <rect x="38" y="20" width="8" height="11" rx="1.2" fill="#c49222"/>
                            <rect x="51.5" y="12" width="14" height="30" rx="2.4" fill="#2c3342"/>
                            <rect x="51.5" y="6" width="14" height="9" rx="1.8" fill="#f2f5f8"/>
                            <rect x="54.5" y="20" width="8" height="11" rx="1.2" fill="#121722"/>
                        </svg>
                        break;
                    case TileIcon.Paper:
                        <svg viewBox="0 0 64 40" focusable="false">
                            <ellipse cx="14" cy="20" rx="12" ry="17" fill="#c5d2e2"/>
                            <rect x="14" y="3" width="24" height="34" fill="#f8fafc"/>
                            <ellipse cx="38" cy="20" rx="17" ry="17" fill="#f4f7fb"/>
                            <ellipse cx="38" cy="20" rx="10" ry="10" fill="#d3ddea"/>
                            <ellipse cx="38" cy="20" rx="3.2" ry="3.2" fill="#8b9db2"/>
                        </svg>
                        break;
                    case TileIcon.Laminating:
                        <svg viewBox="0 0 64 46" focusable="false">
                            <path d="M34 28c8 1 18 6 24 14H36c-2-6-6-11-12-13 3 0 7 0 10-1z" fill="#c5dff2"/>
                            <ellipse cx="14" cy="18" rx="11" ry="15" fill="#c5d3e3"/>
                            <rect x="14" y="3" width="22" height="30" fill="#f4f8fb"/>
                            <ellipse cx="36" cy="18" rx="15" ry="15" fill="#f7fafc"/>
                            <ellipse cx="36" cy="18" rx="8" ry="8" fill="#d2e5f2"/>
                            <ellipse cx="36" cy="18" rx="2.6" ry="2.6" fill="#6d9cb4"/>
                            <path d="M20 8h14" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round"/>
                        </svg>
                        break;
                    case TileIcon.PrinterHeads:
                        <svg viewBox="0 0 64 48" focusable="false">
                            <rect x="6" y="6" width="52" height="24" rx="3" fill="#2c3342"/>
                            <rect x="10" y="10" width="20" height="16" rx="2" fill="#f2f5f8"/>
                            <rect x="34" y="10" width="20" height="16" rx="2" fill="#c5d3e3"/>
                            <rect x="12" y="30" width="40" height="7" rx="1.5" fill="#8b9db2"/>
                            <rect x="16" y="37" width="3" height="5" rx="1" fill="#1496c9"/>
                            <rect x="24" y="37" width="3" height="5" rx="1" fill="#d23a86"/>
                            <rect x="32" y="37" width="3" height="5" rx="1" fill="#f0c04a"/>
                            <rect x="40" y="37" width="3" height="5" rx="1" fill="#121722"/>
                            <rect x="46" y="37" width="3" height="5" rx="1" fill="#c5d3e3"/>
                        </svg>
                        break;
                    default:
                        <svg viewBox="0 0 64 48" focusable="false">
                            <path d="M8 16 32 6l24 10v22L32 46 8 38z" fill="#c5d3e3"/>
                            <path d="M8 16l24 10 24-10" fill="none" stroke="#f4f8fb" stroke-width="2.4" stroke-linejoin="round"/>
                            <path d="M32 26v20" stroke="#f4f8fb" stroke-width="2.4"/>
                            <path d="M20 11l24 10" stroke="#8b9db2" stroke-width="2.4"/>
                        </svg>
                        break;
                }
            </span>
            <span class="epx-supply-tile-copy">
                <span class="epx-supply-tile-name">@type.Name</span>
                <span class="epx-supply-tile-count">@type.Count.ToString(CultureInfo.InvariantCulture)</span>
                <span class="epx-supply-tile-unit">Items</span>
            </span>
            <span class="epx-supply-tile-chevron" aria-hidden="true">›</span>
        </a>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Prefix { get; set; } = "";

    [Parameter]
    public IReadOnlyList<SupplyTypeCount> Counts { get; set; } = [];

    private enum TileIcon { Generic, Cartridges, Paper, Laminating, PrinterHeads }

    // The four initial types keep their own icons; a type added later in Configuration shows the generic box.
    private static TileIcon IconFor(string name) => name.Trim().ToUpperInvariant() switch
    {
        "CARTRIDGES" => TileIcon.Cartridges,
        "PAPER" => TileIcon.Paper,
        "LAMINATING MATERIALS" => TileIcon.Laminating,
        "PRINTER HEADS" => TileIcon.PrinterHeads,
        _ => TileIcon.Generic
    };
}
