@using System.Globalization

<div class="epx-supply-categories">
    <a id="@($"{Prefix}-cartridges")" class="epx-supply-tile" href="/technician/inventory#cartridges">
        <span class="epx-supply-tile-icon" aria-hidden="true">
            <svg viewBox="0 0 68 48" focusable="false">
                <rect x="2" y="12" width="14" height="30" rx="2.4" fill="#1496c9"/>
                <rect x="2" y="6" width="14" height="9" rx="1.8" fill="#f2f5f8"/>
                <rect x="5" y="20" width="8" height="11" rx="1.2" fill="#0c6f96"/>
                <rect x="18.5" y="12" width="14" height="30" rx="2.4" fill="#d23a86"/>
                <rect x="18.5" y="6" width="14" height="9" rx="1.8" fill="#f2f5f8"/>
                <rect x="21.5" y="20" width="8" height="11" rx="1.2" fill="#9d215f"/>
                <rect x="35" y="12" width="14" height="30" rx="2.4" fill="#f0c04a"/>
                <rect x="35" y="6" width="14" height="9" rx="1.8" fill="#f2f5f8"/>
                <rect x="38" y="20" width="8" height="11" rx="1.2" fill="#c49222"/>
                <rect x="51.5" y="12" width="14" height="30" rx="2.4" fill="#2c3342"/>
                <rect x="51.5" y="6" width="14" height="9" rx="1.8" fill="#f2f5f8"/>
                <rect x="54.5" y="20" width="8" height="11" rx="1.2" fill="#121722"/>
            </svg>
        </span>
        <span class="epx-supply-tile-copy">
            <span class="epx-supply-tile-name">Ink Cartridges</span>
            <span class="epx-supply-tile-count">@Cartridges.ToString(CultureInfo.InvariantCulture)</span>
            <span class="epx-supply-tile-unit">Items</span>
        </span>
        <span class="epx-supply-tile-chevron" aria-hidden="true">›</span>
    </a>
    <a id="@($"{Prefix}-paper")" class="epx-supply-tile" href="/technician/inventory#paper">
        <span class="epx-supply-tile-icon" aria-hidden="true">
            <svg viewBox="0 0 64 40" focusable="false">
                <ellipse cx="14" cy="20" rx="12" ry="17" fill="#c5d2e2"/>
                <rect x="14" y="3" width="24" height="34" fill="#f8fafc"/>
                <ellipse cx="38" cy="20" rx="17" ry="17" fill="#f4f7fb"/>
                <ellipse cx="38" cy="20" rx="10" ry="10" fill="#d3ddea"/>
                <ellipse cx="38" cy="20" rx="3.2" ry="3.2" fill="#8b9db2"/>
            </svg>
        </span>
        <span class="epx-supply-tile-copy">
            <span class="epx-supply-tile-name">Paper</span>
            <span class="epx-supply-tile-count">@Paper.ToString(CultureInfo.InvariantCulture)</span>
            <span class="epx-supply-tile-unit">Items</span>
        </span>
        <span class="epx-supply-tile-chevron" aria-hidden="true">›</span>
    </a>
    <a id="@($"{Prefix}-laminating")" class="epx-supply-tile" href="/technician/inventory#laminating">
        <span class="epx-supply-tile-icon" aria-hidden="true">
            <svg viewBox="0 0 64 46" focusable="false">
                <path d="M34 28c8 1 18 6 24 14H36c-2-6-6-11-12-13 3 0 7 0 10-1z" fill="#c5dff2"/>
                <ellipse cx="14" cy="18" rx="11" ry="15" fill="#c5d3e3"/>
                <rect x="14" y="3" width="22" height="30" fill="#f4f8fb"/>
                <ellipse cx="36" cy="18" rx="15" ry="15" fill="#f7fafc"/>
                <ellipse cx="36" cy="18" rx="8" ry="8" fill="#d2e5f2"/>
                <ellipse cx="36" cy="18" rx="2.6" ry="2.6" fill="#6d9cb4"/>
                <path d="M20 8h14" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round"/>
            </svg>
        </span>
        <span class="epx-supply-tile-copy">
            <span class="epx-supply-tile-name">Lamination Materials</span>
            <span class="epx-supply-tile-count">@LaminatingMaterials.ToString(CultureInfo.InvariantCulture)</span>
            <span class="epx-supply-tile-unit">Items</span>
        </span>
        <span class="epx-supply-tile-chevron" aria-hidden="true">›</span>
    </a>
</div>

@code {
    [Parameter, EditorRequired]
    public string Prefix { get; set; } = "";

    [Parameter]
    public int Cartridges { get; set; }

    [Parameter]
    public int Paper { get; set; }

    [Parameter]
    public int LaminatingMaterials { get; set; }
}
