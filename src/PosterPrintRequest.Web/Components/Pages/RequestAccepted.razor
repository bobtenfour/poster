@page "/request/accepted/{PosterId}"
@attribute [Authorize(Policy = PosterAccess.UserPolicy)]
@inject NavigationManager Navigation
@using System.Globalization
@using PosterPrintRequest.Web.Requests

<PageTitle>Request accepted</PageTitle>

<section class="epx-blueignix-home" aria-label="Request accepted">
    @if (HistoricalRequestNotLinked)
    {
        <PageHeader Kicker="UIC Dentistry School"
                    Title="Request not available"
                    Subtitle="@AcceptanceLookup.HistoricalNotLinkedMessage" />
    }
    else if (Details is null)
    {
        <PageHeader Kicker="UIC Dentistry School"
                    Title="Request not found"
                    Subtitle="Check the Poster ID and open the confirmation again." />
    }
    else
    {
        <PageHeader Kicker="UIC Dentistry School"
                    Title="Request accepted"
                    Subtitle="This poster request is accepted. Keep the Poster ID below." />

        <p class="epx-blueignix-kicker">Poster ID</p>
        <p class="epx-poster-id">@Details.PosterId</p>

        <dl class="epx-meta">
            <div>
                <dt>Requester</dt>
                <dd>@Details.RequesterName</dd>
            </div>
            <div>
                <dt>Event</dt>
                <dd>@(string.IsNullOrWhiteSpace(Details.EventName) ? "No event" : Details.EventName)</dd>
            </div>
            <div>
                <dt>Date in</dt>
                <dd>@Details.DateIn.ToString("MMMM d, yyyy 'at' h:mm tt", CultureInfo.CurrentCulture)</dd>
            </div>
            <div>
                <dt>Lamination</dt>
                <dd>@(Details.LaminationRequested ? "Requested" : "Not requested")</dd>
            </div>
        </dl>

        @if (Details.TdxTicketId is int ticketId)
        {
            <p class="epx-blueignix-kicker">TDX ticket</p>
            <p class="epx-poster-id">@ticketId.ToString(CultureInfo.InvariantCulture)</p>
        }

        <Callout Kicker="Next" Title="TDX ticket" Tone="info">
            @if (Details.TdxTicketId is int createdId)
            {
                <text>TDX ticket @createdId.ToString(CultureInfo.InvariantCulture) was created for this request. </text>
            }
            else if (Details.TdxTicketState is PosterPrintRequest.Domain.TdxTicketStates.Pending or PosterPrintRequest.Domain.TdxTicketStates.Uncertain)
            {
                <text>The TDX ticket for this request is being created. Technicians already have your request. </text>
            }
            The poster will be printed within the next 48 hours.
        </Callout>

        <div class="epx-form-actions">
            <a class="epx-button epx-button-primary" href="@ApplicationUris.BrowserPath(Navigation, "/request")">Start another request</a>
            <a class="epx-button" href="@ApplicationUris.BrowserPath(Navigation, "/help")">Staff Help</a>
        </div>
    }
</section>
