@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<a class="epx-skip-link" href="#epx-main-content">Skip to main content</a>
<div class="epx-shell">
    <header class="epx-shell-header">
        <nav class="epx-nav-primary" aria-label="Primary">
            <a class="epx-brand" href="/" aria-label="BlueIgnix Poster Print Request System">
                <span class="epx-blueignix-brand-copy">
                    <span class="epx-blueignix-brand-owner">BlueIgnix</span>
                    <span class="epx-blueignix-brand-product">Poster Print Request</span>
                </span>
            </a>
            <div class="epx-nav-disclosure">
                <input id="epx-nav-menu" class="epx-nav-toggle-input" type="checkbox" />
                <label class="epx-nav-toggle" for="epx-nav-menu">Menu</label>
                <ul class="epx-nav-list">
                    <li>
                        <ShellNavLink Href="/" MatchAll="true">Home</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/help">Help</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/request">Request</ShellNavLink>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="epx-shell-workspace">
        <div class="epx-blueignix-topbar">
            <div class="epx-blueignix-topbar-lead">
                <p class="epx-blueignix-kicker epx-blueignix-topbar-kicker">Service</p>
                <p class="epx-blueignix-topbar-user">@SignedIn</p>
            </div>
            <div class="epx-blueignix-context">
                <span class="epx-blueignix-context-label">Audience</span>
                <span class="epx-blueignix-context-value">Students and staff</span>
            </div>
            <form class="epx-sign-out" method="post" action="/Account/Logout" data-enhance="false">
                <AntiforgeryToken />
                <button class="epx-button" type="submit">Log out</button>
            </form>
        </div>
        <main id="epx-main-content" class="epx-landmark-main" tabindex="-1">
            @Body
        </main>
        <footer class="epx-footer">
            <p>BlueIgnix Poster Print Request System</p>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" role="alert">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">Dismiss</a>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string SignedIn { get; set; } = "Student or staff";

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        var state = await AuthenticationState;
        var name = state.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            SignedIn = name;
        }
    }
}
