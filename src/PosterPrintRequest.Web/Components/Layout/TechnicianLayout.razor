@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation

<a class="epx-skip-link" href="#epx-main-content">Skip to main content</a>
<div class="epx-shell">
    <header class="epx-shell-header">
        <nav class="epx-nav-primary" aria-label="Technician">
            <a class="epx-brand" href="@ApplicationUris.BrowserPath(Navigation, InstitutionalEntry.OperatorHome)" aria-label="UIC Dentistry School Technician Workspace">
                <span class="epx-blueignix-brand-copy">
                    <span class="epx-blueignix-brand-owner">UIC Dentistry School</span>
                    <span class="epx-blueignix-brand-product">Technician workspace</span>
                </span>
            </a>
            <div class="epx-nav-disclosure">
                <input id="epx-tech-nav-menu" class="epx-nav-toggle-input" type="checkbox" />
                <label class="epx-nav-toggle" for="epx-tech-nav-menu">Menu</label>
                <ul class="epx-nav-list">
                    <li>
                        <ShellNavLink Href="/technician" ExceptPrefix="/technician/library" ExceptPrefix2="/technician/inventory" ExceptPrefix3="/technician/configuration" ExceptPrefix4="/technician/help">Dashboard</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/technician/library">Library</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/technician/inventory">Inventory</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/technician/configuration">Configuration</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/technician/help">Help</ShellNavLink>
                    </li>
                    @if (AlsoRequester)
                    {
                        <li>
                            <ShellNavLink Href="@InstitutionalEntry.StaffHome">Staff</ShellNavLink>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <div class="epx-shell-workspace">
        <div class="epx-blueignix-topbar">
            <div class="epx-blueignix-topbar-lead">
                <p class="epx-blueignix-topbar-user">@SignedIn</p>
            </div>
            <form class="epx-tech-search" method="get" action="@ApplicationUris.BrowserPath(Navigation, InstitutionalEntry.OperatorHome)">
                <label class="epx-label" for="workspace-poster-id">Poster ID</label>
                <input id="workspace-poster-id" class="epx-input" name="posterId" type="search" autocomplete="off" spellcheck="false" />
                <button class="epx-button epx-button-primary" type="submit">Find</button>
            </form>
        </div>
        <main id="epx-main-content" class="epx-landmark-main" tabindex="-1">
            @Body
        </main>
        <footer class="epx-footer">
            <p>UIC Dentistry School Technician Workspace</p>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" role="alert">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">Dismiss</a>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string SignedIn { get; set; } = "Technician";

    private bool AlsoRequester { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        var state = await AuthenticationState;
        var name = state.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            SignedIn = name;
        }

        AlsoRequester = (await Authorization.AuthorizeAsync(state.User, PosterAccess.UserPolicy)).Succeeded;
    }
}
