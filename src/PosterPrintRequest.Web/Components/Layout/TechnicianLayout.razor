@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation
@inject IServiceScopeFactory Scopes
@using PosterPrintRequest.Web.Requests

<a class="epx-skip-link" href="#epx-main-content">Skip to main content</a>
<div class="epx-shell">
    <header class="epx-shell-header">
        <nav class="epx-nav-primary" aria-label="Technician">
            <a class="epx-brand" href="@ApplicationUris.BrowserPath(Navigation, InstitutionalEntry.OperatorHome)" aria-label="UIC Dentistry School Technician Workspace">
                <img class="epx-brand-logo" src="@ApplicationUris.BrowserPath(Navigation, "/img/brand/uic-logo-inverted.svg")" alt="University of Illinois Chicago" width="358" height="69" />
                <span class="epx-blueignix-brand-copy">
                    <span class="epx-blueignix-brand-product">Technician workspace</span>
                </span>
            </a>
            <div class="epx-nav-disclosure">
                <input id="epx-tech-nav-menu" class="epx-nav-toggle-input" type="checkbox" />
                <label class="epx-nav-toggle" for="epx-tech-nav-menu">Menu</label>
                <ul class="epx-nav-list">
                    <li>
                        <ShellNavLink Href="/technician" ExceptPrefix="/technician/library" ExceptPrefix2="/technician/inventory" ExceptPrefix3="/technician/configuration" ExceptPrefix4="/technician/help">Dashboard</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/technician/library">Library</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/technician/inventory">Inventory</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/technician/configuration">Configuration</ShellNavLink>
                    </li>
                    <li>
                        <ShellNavLink Href="/technician/help">Help</ShellNavLink>
                    </li>
                    @if (AlsoRequester)
                    {
                        <li>
                            <ShellNavLink Href="@InstitutionalEntry.StaffHome">Staff</ShellNavLink>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <div class="epx-shell-workspace">
        <div class="epx-blueignix-topbar">
            <div class="epx-blueignix-topbar-lead">
                <p class="epx-blueignix-topbar-user">@SignedIn</p>
            </div>
            @* Technician Search Contract v1, section 3: one line; only the fields of the chosen category are shown;
               after a search the dropdown is back on Selection with empty fields. *@
            <form class="epx-tech-search" method="get" action="@ApplicationUris.BrowserPath(Navigation, InstitutionalEntry.OperatorHome)">
                <label class="epx-label" for="workspace-search-by">Search by</label>
                <select id="workspace-search-by" class="epx-select epx-search-by" name="by" required>
                    <option value="">@PosterSearchModes.SelectionLabel</option>
                    @foreach (var (value, label) in PosterSearchModes.All)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
                <label class="epx-sr-only" for="workspace-search-text">Search text</label>
                <input id="workspace-search-text" class="epx-input epx-search-text" name="q" type="search" autocomplete="off" spellcheck="false" />
                <label class="epx-label epx-search-date" for="workspace-search-from">From</label>
                <input id="workspace-search-from" class="epx-input epx-search-date" name="from" type="date" />
                <label class="epx-label epx-search-date" for="workspace-search-to">To</label>
                <input id="workspace-search-to" class="epx-input epx-search-date" name="to" type="date" />
                <label class="epx-sr-only" for="workspace-search-event">Event</label>
                <select id="workspace-search-event" class="epx-select epx-search-event" name="event">
                    <option value="">Choose an event</option>
                    @foreach (var item in Events)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
                <button class="epx-button epx-button-primary epx-search-find" type="submit">Find</button>
            </form>
            <SignOutForm />
        </div>
        <main id="epx-main-content" class="epx-landmark-main" tabindex="-1">
            @Body
        </main>
        <footer class="epx-footer">
            <p>UIC Dentistry School Technician Workspace</p>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" role="alert">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">Dismiss</a>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string SignedIn { get; set; } = "Technician";

    private bool AlsoRequester { get; set; }

    private IReadOnlyList<PosterSearchEvent> Events { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        // The layout renders at the same time as the page, which uses the request's DbContext; the event
        // list is read in its own scope so the two never share one context.
        await using (var scope = Scopes.CreateAsyncScope())
        {
            Events = await scope.ServiceProvider.GetRequiredService<ITechnicianSearch>().EventsAsync(CancellationToken.None);
        }

        if (AuthenticationState is null)
        {
            return;
        }

        var state = await AuthenticationState;
        var name = state.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            SignedIn = name;
        }

        AlsoRequester = (await Authorization.AuthorizeAsync(state.User, PosterAccess.UserPolicy)).Succeeded;
    }
}
