@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    // The session ended (Authentication Contract section 5.9): leave the circuit with a full page load
    // to the application entry, which starts a new Entra authentication.
    private async void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        var current = await state;
        if (current.User.Identity?.IsAuthenticated != true)
        {
            await InvokeAsync(() => Navigation.NavigateTo(ApplicationUris.BrowserPath(Navigation, "/"), forceLoad: true));
        }
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
